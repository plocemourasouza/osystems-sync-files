{
  "name": "osystems-sync",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e:unit": "node --test tests/e2e/__tests__/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "package:win": "node scripts/package-win.mjs",
    "lint": "eslint src",
    "longevity": "node tests/e2e/longevity.mjs",
    "longevity:report": "node tests/e2e/longevity.mjs --mode report",
    "build:win": "XWIN_ACCEPT_LICENSE=1 PATH=/opt/homebrew/opt/llvm/bin:$PATH CC_x86_64_pc_windows_msvc=clang-cl CXX_x86_64_pc_windows_msvc=clang-cl AR_x86_64_pc_windows_msvc=llvm-lib tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis && node scripts/package-win.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lucide-react": "^1.41.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.4",
    "vitest": "^2.0.0",
    "vitest-axe": "^1.0.0-pre.5"
  }
}
